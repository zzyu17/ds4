We need answer. Need analyze vulnerability. Need determine primary bug line(s). Need be careful. Function parse_ipv6_reduced. Need identify bug. Let's inspect.

Code:
static int parse_ipv6_reduced(const char *src, uint8_t dst[16])
{
    uint8_t tmp[16];
    uint8_t *tp = tmp;
    uint8_t *colonp = NULL;

    if (src[0] == ':' && src[1] == ':') {
        colonp = --tp;          // remember compression point at beginning
        src += 2;
    }

    while (*src != '\0') {
        unsigned v = parse_hextet(&src);
        *tp++ = (uint8_t)(v >> 8);
        *tp++ = (uint8_t)v;
        if (*src == ':') src++;
    }

    if (colonp != NULL) {
        size_t n = (size_t)(tp - colonp);
        memmove(colonp + (16 - (tp - tmp)), colonp, n);
        memset(colonp, 0, 16 - (tp - tmp));
    }

    memcpy(dst, tmp, 16);
    return 0;
}

