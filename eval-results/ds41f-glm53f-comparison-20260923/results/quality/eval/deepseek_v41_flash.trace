static int inet_pton6(const char *src, u_char *dst) {
    static const char xdigits_l[] = "0123456789abcdef", ...
    u_char tmp[NS_IN6ADDRSZ], *tp, *endp, *colonp;
    const char *curtok;
    int ch, saw_xdigit;
    u_int val;

    memset(tmp, '\0', NS_IN6ADDRSZ);
    tp = tmp;
    endp = tp + NS_IN6ADDRSZ;
    colonp = NULL;
    if (*src == ':')
        if (*++src != ':')
            return 0;
    curtok = src;
    saw_xdigit = 0;
    val = 0;
    while ((ch = *src++) != '\0') {
        const char *pch;
        if ((pch = strchr(xdigits, ch)) != NULL) {
            val <<= 4;
            val |= (pch - xdigits);
            if (val > 0xffff)
                return 0;
            saw_xdigit = 1;
            continue;
        } else if (ch == ':') {
            curtok = src;
            if (!saw_xdigit) {
                if (colonp)
                    return 0;
                colonp = tp;
                continue;
            } else if (*src == '\0') {
                return 0;
            }
            if (tp + NS_IN6ADDRSZ / 2 > endp)
                return 0;
            *tp++ = (u_char)(val >> 8) & 0xff;
            *tp++ = (u_char)val & 0xff;
            saw_xdigit = 0;
            val = 0;
            continue;
        } else if (ch == '.' && ((tp + NS_IN6ADDRSZ) <= endp) &&
                   inet_pton4(curtok, tp) > 0) {
            tp += NS_IN6ADDRSZ - 4;
            saw_xdigit = 0;
            break;
        } else
            return 0;
    }
    if (saw_xdigit) {
        if (tp + NS_IN6ADDRSZ / 2 > endp)
            return 0;
        *tp++ = (u_char)(val >> 8) & 0xff;
        *tp++ = (u_char)val & 0xff;
    }
    if (colonp != NULL) {
        /*
         * Since some memmove()'s erroneously fail to handle
         * overlapping regions, we'll do the shift by hand.
         */
        const int n = tp - colonp;
        int i;

        if (tp == endp)
            return 0;
        for (i = 1; i <= n; i++) {
            endp[- i] = colonp[n - i];
            colonp[n - i] = 0;
        }
        tp = endp;
    }
    if (tp != endp)
        return 0;
    memcpy(dst, tmp, NS_IN6ADDRSZ);
    return 1;
}

