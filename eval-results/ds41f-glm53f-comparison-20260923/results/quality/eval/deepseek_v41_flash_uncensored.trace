static bool ensure_tag_buffer(struct Parser *p, size_t prefix_len, size_t name_len)
{
    unsigned int need = (unsigned int)(prefix_len + name_len + 3);

    if (need > p->tag_cap) {
        char *q = realloc(p->tag_buf, need);
        if (q == NULL)
