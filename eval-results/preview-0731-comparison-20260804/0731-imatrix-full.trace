 \fill[draw=black, fill=gray!20] (N) -- (E) -- (C) -- (B) -- cycle;
 \fill[draw=black, fill=gray!20] (A) -- (F) -- (M) -- cycle;
 
 \draw[line width=0.5mm] (A) -- (B) -- (C) -- cycle;

